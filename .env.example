SUPABASE_PROJECT_ID="axrclxwittqyurwqjvdq"
SUPABASE_URL="https://axrclxwittqyurwqjvdq.supabase.co"
SUPABASE_DB_PASSWORD=""
DATABASE_URL="postgresql://postgres.axrclxwittqyurwqjvdq:YOUR_SUPABASE_DB_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?schema=public&sslmode=require"
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL="https://axrclxwittqyurwqjvdq.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
AUTH_PROVIDER="supabase"
MFA_REQUIRED=true
MFA_GRACE_DAYS=7
DONDIE_SCHEDULE_MINUTES=15
DONDIE_SCHEDULER_ENABLED=true
# Full AI power: Dondie chooses strategy, forces AUTOPILOT, unlocks LLM tier when key set.
DONDIE_FULL_POWER=true
DONDIE_FULL_POWER_MAX_TRADES_PER_DAY=20
DONDIE_FULL_POWER_MIN_CONFIDENCE=55
DONDIE_FULL_POWER_TARGET_WALLET_USD=100
# Shared with GitHub Actions secret CRON_SECRET — wakes/runs AUTOPILOT overnight.
CRON_SECRET=
# Survival economics (see docs/dondie-survival-model.md)
DONDIE_STANDARD_MIN_BALANCE=25
DONDIE_PRO_MIN_BALANCE=100
DONDIE_STANDARD_BRAIN_COST_USD=0.05
DONDIE_PRO_BRAIN_COST_USD=0.25
DONDIE_PNL_CREDIT_PERCENT=10
DONDIE_LLM_API_URL=https://api.openai.com/v1
DONDIE_LLM_API_KEY=
DONDIE_LLM_STANDARD_MODEL=gpt-4o-mini
DONDIE_LLM_PRO_MODEL=gpt-4o
# Restrict Dondie to trading only around the monthly NFP release (see docs/dondie-survival-model.md).
# Default is false: Dondie trades every qualifying breakout signal, any day.
DONDIE_NFP_ONLY=false
DONDIE_NFP_WINDOW_MINUTES_BEFORE=15
DONDIE_NFP_WINDOW_MINUTES_AFTER=120
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
AI_SERVICE_URL="http://localhost:8000"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
MFA_ENCRYPTION_KEY=""
BROKER_CREDENTIAL_ENCRYPTION_KEY=""
SESSION_IDLE_TIMEOUT_MINUTES=30
CORS_ORIGINS="http://localhost:3000"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
RATE_LIMIT_DISABLED=false
ALPACA_API_KEY=""
ALPACA_SECRET_KEY=""
ALPACA_ENVIRONMENT="PAPER"
ALLOW_ALPACA_LIVE_TRADING=false
# Server-side order reconciliation: polls working broker orders, records fills, and clears
# orders the broker cannot account for. Runs independently of any browser session.
ORDER_RECONCILIATION_ENABLED=true
ORDER_RECONCILE_SECONDS=60
# A working order with no broker acknowledgement for this long is cancelled locally so it
# stops blocking new orders on its symbol.
ORDER_STALE_MINUTES=30
# Never enable in production. Seeds E2E admin + paper simulator funding for Playwright only.
ENABLE_E2E_SEED=false
# Never enable in production (it is ignored there). Lets an empty broker feed fall back to
# generated candles for local/E2E runs instead of failing closed.
ALLOW_SIMULATED_MARKET_DATA=false
